  "engines": {
    "node": ">=20.19"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:data && npm run check:design && next build",
    "start": "next start",
    "lint": "npm run check:data && npm run check:design && eslint",
    "typecheck": "tsc --noEmit",
    "test:smoke": "playwright test",
