{
  "name": "growthx-seo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GrowthX AI SEO & Autonomous Optimization Platform",
  "workspaces": [
    "growthx-ai-seo",
    "growthx-ai-crawler"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=growthx-ai-seo",
    "dev:frontend": "npm run dev --workspace=growthx-ai-seo",
    "dev:backend": "npm run start:dev --workspace=growthx-ai-crawler",
    "build": "npm run build --workspace=growthx-ai-seo",
    "build:frontend": "npm run build --workspace=growthx-ai-seo",
    "build:backend": "npm run build --workspace=growthx-ai-crawler",
    "lint:frontend": "npm run lint --workspace=growthx-ai-seo",
    "lint:backend": "npm run lint --workspace=growthx-ai-crawler",
    "check": "npm run check:data --workspace=growthx-ai-seo && npm run check:design --workspace=growthx-ai-seo",
    "check:data": "npm run check:data --workspace=growthx-ai-seo",
    "check:design": "npm run check:design --workspace=growthx-ai-seo",
    "test:frontend": "npm run test:smoke --workspace=growthx-ai-seo",
    "test:backend": "npm run test --workspace=growthx-ai-crawler"
  }
}

