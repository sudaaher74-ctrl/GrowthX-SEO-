datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum IssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum LinkType {
  INTERNAL
  EXTERNAL
}

enum SchemaType {
  ORGANIZATION
  LOCAL_BUSINESS
  PRODUCT
  ARTICLE
  BREADCRUMB
  FAQ
  REVIEW
  VIDEO
  RECIPE
  EVENT
  OTHER
}

enum FixStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  APPLIED
}

model Website {
  id                String    @id @default(uuid())
  domain            String    @unique
  url               String
  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?
  verificationToken String?
  webhookSecret     String?
  authCredentials   String? // Encrypted basic auth or cookie JSON
  rateLimitDelayMs  Int       @default(500)
  maxConcurrency    Int       @default(5)
  maxDepth          Int       @default(10)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  crawlJobs CrawlJob[]

  @@index([domain])
}

model CrawlJob {
  id           String    @id @default(uuid())
  websiteId    String
  status       JobStatus @default(PENDING)
  pagesCrawled Int       @default(0)
  issuesFound  Int       @default(0)
  concurrency  Int       @default(5)
  depthLimit   Int       @default(10)
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  website        Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  pages          Page[]
  issues         Issue[]
  internalGraphs InternalGraph[]

  @@index([websiteId, status])
  @@index([createdAt])
}

model Page {
  id              String   @id @default(uuid())
  crawlJobId      String
  url             String
  finalUrl        String
  statusCode      Int
  responseTimeMs  Int
  contentType     String?
  title           String?
  metaDescription String?
  canonicalUrl    String?
  robotsMeta      String?
  h1              String[] @default([])
  h2              String[] @default([])
  h3              String[] @default([])
  wordCount       Int      @default(0)
  readingTimeMin  Float    @default(0)
  duplicateScore  Float    @default(0)
  contentHash     String?
  simHash         String?
  htmlSnapshotUrl String?
  screenshotUrl   String?
  crawledAt       DateTime @default(now())

  crawlJob    CrawlJob     @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  issues      Issue[]
  images      Image[]
  links       Link[]
  schemas     Schema[]
  performance Performance?

  @@unique([crawlJobId, url])
  @@index([crawlJobId, statusCode])
  @@index([url])
  @@index([contentHash])
}

model Issue {
  id             String        @id @default(uuid())
  crawlJobId     String
  pageId         String?
  issueType      String
  severity       IssueSeverity
  affectedUrl    String
  description    String
  recommendation String
  status         IssueStatus   @default(OPEN)
  aiFixAvailable Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  crawlJob         CrawlJob          @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  page             Page?             @relation(fields: [pageId], references: [id], onDelete: SetNull)
  aiRecommendation AIRecommendation?

  @@index([crawlJobId, severity])
  @@index([affectedUrl, status])
  @@index([issueType])
}

model Image {
  id           String   @id @default(uuid())
  pageId       String
  imageUrl     String
  altText      String?
  sizeBytes    Int?
  width        Int?
  height       Int?
  isLazy       Boolean  @default(false)
  isMissingAlt Boolean  @default(false)
  isBroken     Boolean  @default(false)
  isLarge      Boolean  @default(false)
  createdAt    DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([isMissingAlt, isBroken])
}

model Link {
  id           String   @id @default(uuid())
  sourcePageId String
  targetUrl    String
  linkType     LinkType
  isBroken     Boolean  @default(false)
  isRedirect   Boolean  @default(false)
  isNofollow   Boolean  @default(false)
  anchorText   String?
  createdAt    DateTime @default(now())

  sourcePage Page @relation(fields: [sourcePageId], references: [id], onDelete: Cascade)

  @@index([sourcePageId, linkType])
  @@index([targetUrl])
}

model Schema {
  id               String     @id @default(uuid())
  pageId           String
  schemaType       SchemaType
  isValid          Boolean    @default(true)
  validationErrors String[]   @default([])
  rawJson          String?
  createdAt        DateTime   @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, schemaType])
}

model Performance {
  id                 String   @id @default(uuid())
  pageId             String   @unique
  performanceScore   Int?
  accessibilityScore Int?
  bestPracticesScore Int?
  seoScore           Int?
  lcpMs              Float?
  inpMs              Float?
  clsScore           Float?
  fetchedAt          DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([performanceScore])
}

model InternalGraph {
  id              String   @id @default(uuid())
  crawlJobId      String
  sourceUrl       String
  targetUrl       String
  crawlDepth      Int      @default(0)
  linkEquityScore Float    @default(1.0)
  createdAt       DateTime @default(now())

  crawlJob CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)

  @@index([crawlJobId, sourceUrl])
  @@index([crawlJobId, targetUrl])
  @@index([crawlJobId, crawlDepth])
}

model AIRecommendation {
  id                  String    @id @default(uuid())
  issueId             String    @unique
  whyItMatters        String
  seoImpact           String
  businessImpact      String
  priorityScore       Int       @default(50) // 1 - 100
  recommendedFixPatch String // JSON or copy-ready text patch
  expectedOutcome     String
  status              FixStatus @default(PENDING_APPROVAL)
  approvedBy          String?
  appliedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([status, priorityScore])
}
