generator client {
  provider = "prisma-client-js"
}

// On Neon, DATABASE_URL points at the connection pooler (the `-pooler` host),
// which is what the running app should use: it multiplexes many short-lived
// connections onto few Postgres backends, which is exactly the shape of web
// traffic. Migrations are the opposite — they need session state and advisory
// locks that the pooler does not carry across statements — so Prisma is given a
// direct, unpooled URL for them via `directUrl`.
//
// DIRECT_URL is the same connection string with `-pooler` removed from the
// host. Prisma treats a declared `directUrl` as required and fails validation
// when the variable is missing, rather than falling back to `url` — so
// docker-entrypoint.sh derives it from DATABASE_URL when it is not set, and a
// deployment that configures only DATABASE_URL still boots.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Website {
  id                String         @id @default(uuid())
  domain            String         @unique
  url               String
  isVerified        Boolean        @default(false)
  verifiedAt        DateTime?
  verificationToken String?
  webhookSecret     String?
  authCredentials   String?
  rateLimitDelayMs  Int            @default(500)
  maxConcurrency    Int            @default(5)
  maxDepth          Int            @default(10)
  /// Monthly by default: gentle enough not to swamp a small instance, while
  /// keeping every verified site on some schedule rather than silently
  /// dropping recurring crawls. Set OFF to opt a site out entirely.
  crawlFrequency    CrawlFrequency @default(MONTHLY)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  projectId         String?
  crawlJobs         CrawlJob[]
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Competitors, across any project, whose domain this is.
  ///
  /// A competitor's site is stored with projectId left null. That is what
  /// keeps it out of the customer's own analysis for free: every query that
  /// reads a project's pages filters on `website.projectId`, so a null one
  /// can never be mistaken for the customer's own content. Marking it with a
  /// flag instead would have made correctness depend on remembering to
  /// exclude it in a dozen places.
  competitors       CompetitorDomain[]

  @@index([domain])
  @@index([isVerified, crawlFrequency])
}

model CrawlJob {
  id             String          @id @default(uuid())
  websiteId      String
  status         JobStatus       @default(PENDING)
  pagesCrawled   Int             @default(0)
  issuesFound    Int             @default(0)
  concurrency    Int             @default(5)
  depthLimit     Int             @default(10)
  /// Hard ceiling on pages fetched by this job. Null means no ceiling, which
  /// is the right answer for a customer's own site and the wrong one for a
  /// competitor's: that is a third party who never asked to be crawled, and
  /// their bandwidth is not ours to spend without a bound.
  pageLimit           Int?
  startedAt           DateTime?
  finishedAt          DateTime?
  errorMessage        String?
  healthScore         Int?
  uniqueIssuesCount   Int             @default(0)
  resolvedIssuesCount Int             @default(0)
  qualityDiagnostics  Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  website        Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  internalGraphs InternalGraph[]
  issues         Issue[]
  pages          Page[]

  @@index([websiteId, status])
  @@index([createdAt])
}

model Page {
  id              String       @id @default(uuid())
  crawlJobId      String
  url             String
  finalUrl        String
  statusCode      Int
  responseTimeMs  Int
  contentType     String?
  title           String?
  metaDescription String?
  canonicalUrl    String?
  robotsMeta      String?
  h1              String[]     @default([])
  h2              String[]     @default([])
  h3              String[]     @default([])
  wordCount       Int          @default(0)
  readingTimeMin  Float        @default(0)
  duplicateScore  Float        @default(0)
  contentHash     String?
  simHash         String?
  /// HOME | SERVICE | PRODUCT | LOCATION | BLOG | CASE_STUDY | FAQ | ABOUT |
  /// CONTACT | LEGAL | OTHER. Derived from the URL and headings at crawl time.
  /// Every gap comparison counts pages by kind, so this is what makes "they
  /// have 24 service pages you do not" answerable rather than a URL total.
  pageType        String       @default("OTHER")
  htmlSnapshotUrl String?
  screenshotUrl   String?
  crawledAt       DateTime     @default(now())
  aeoMetrics      AeoMetrics?
  images          Image[]
  issues          Issue[]
  links           Link[]
  crawlJob        CrawlJob     @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  performance     Performance?
  schemas         Schema[]

  @@unique([crawlJobId, url])
  @@index([crawlJobId, statusCode])
  @@index([crawlJobId, pageType])
  @@index([url])
  @@index([contentHash])
}

model AeoMetrics {
  id                  String   @id @default(uuid())
  pageId              String   @unique
  llmCrawlerHits      Int      @default(0)
  citationProbability Float    @default(0.0)
  hasStructuredJsonLd Boolean  @default(false)
  hasSemanticHtml     Boolean  @default(false)
  lastEvaluatedAt     DateTime @default(now())
  page                Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Issue {
  id               String            @id @default(uuid())
  crawlJobId       String
  pageId           String?
  issueType        String
  severity         IssueSeverity
  affectedUrl      String
  description      String
  recommendation   String
  status           IssueStatus       @default(OPEN)
  aiFixAvailable   Boolean           @default(false)
  confidence       String            @default("LIKELY")
  impact           String?
  explanation      String?
  evidence         String?
  dedupKey         String?
  category         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  aiRecommendation AIRecommendation?
  crawlJob         CrawlJob          @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  page             Page?             @relation(fields: [pageId], references: [id])

  @@index([crawlJobId, severity])
  @@index([affectedUrl, status])
  @@index([issueType])
  @@index([crawlJobId, dedupKey])
  @@index([crawlJobId, category])
}

model Image {
  id           String   @id @default(uuid())
  pageId       String
  imageUrl     String
  altText      String?
  sizeBytes    Int?
  width        Int?
  height       Int?
  isLazy       Boolean  @default(false)
  isMissingAlt Boolean  @default(false)
  isBroken     Boolean  @default(false)
  isLarge      Boolean  @default(false)
  createdAt    DateTime @default(now())
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([isMissingAlt, isBroken])
}

model Link {
  id           String   @id @default(uuid())
  sourcePageId String
  targetUrl    String
  linkType     LinkType
  isBroken     Boolean  @default(false)
  isRedirect   Boolean  @default(false)
  isNofollow   Boolean  @default(false)
  anchorText   String?
  createdAt    DateTime @default(now())
  sourcePage   Page     @relation(fields: [sourcePageId], references: [id], onDelete: Cascade)

  @@index([sourcePageId, linkType])
  @@index([targetUrl])
}

model Schema {
  id               String     @id @default(uuid())
  pageId           String
  schemaType       SchemaType
  isValid          Boolean    @default(true)
  validationErrors String[]   @default([])
  rawJson          String?
  createdAt        DateTime   @default(now())
  page             Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, schemaType])
}

model Performance {
  id                 String   @id @default(uuid())
  pageId             String   @unique
  performanceScore   Int?
  accessibilityScore Int?
  bestPracticesScore Int?
  seoScore           Int?
  lcpMs              Float?
  inpMs              Float?
  clsScore           Float?
  fetchedAt          DateTime @default(now())
  page               Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([performanceScore])
}

model InternalGraph {
  id              String   @id @default(uuid())
  crawlJobId      String
  sourceUrl       String
  targetUrl       String
  crawlDepth      Int      @default(0)
  linkEquityScore Float    @default(1.0)
  createdAt       DateTime @default(now())
  crawlJob        CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)

  @@index([crawlJobId, sourceUrl])
  @@index([crawlJobId, targetUrl])
  @@index([crawlJobId, crawlDepth])
}

model AIRecommendation {
  id                  String    @id @default(uuid())
  issueId             String    @unique
  whyItMatters        String
  seoImpact           String
  businessImpact      String
  priorityScore       Int       @default(50)
  recommendedFixPatch String
  expectedOutcome     String
  /// Which model produced this, e.g. "claude-opus-5" or "rules-engine". Lets us
  /// audit what a customer actually got for their plan.
  generatedByModel    String?
  status              FixStatus @default(PENDING_APPROVAL)
  approvedBy          String?
  appliedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  issue               Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([status, priorityScore])
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  firstName    String?
  lastName     String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  auditLogs    AuditLog[]
  memberships  OrganizationMember[]
}

model Organization {
  id           String               @id @default(uuid())
  name         String
  slug         String               @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  auditLogs    AuditLog[]
  members      OrganizationMember[]
  projects     Project[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Project {
  id                   String                 @id @default(uuid())
  name                 String
  organizationId       String
  /// Agency-facing retainer label, e.g. "Scale" / "Growth" / "Starter".
  /// Free text so an agency can use its own tier names.
  tier                 String?
  /// Monthly retainer in the currency's minor unit (paise / cents). Null when
  /// the agency has not recorded one — the portfolio then shows "—" and the
  /// figure is excluded from MRR rather than being guessed at.
  retainerMonthlyMinor Int?
  retainerCurrency     String                 @default("INR")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  ClientPortalConfig   ClientPortalConfig?
  competitors          CompetitorDomain[]
  contentPieces        ContentPiece[]
  CustomReport         CustomReport[]
  IntegrationConfig    IntegrationConfig?
  LocalLocation        LocalLocation?
  MarketIntelligence   MarketIntelligence?
  MonitoringConfig     MonitoringConfig?
  OutreachCampaign     OutreachCampaign[]
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository           SiteRepository?
  strategies           StrategyReport[]
  prompts              TrackedPrompt[]
  websites             Website[]
  LocalReview          LocalReview[]
  AgentRun             AgentRun[]
  Evidence             Evidence[]
  Recommendation       Recommendation[]
  MarketResearchThread MarketResearchThread[]
  MarketOpportunity    MarketOpportunity[]
  MarketAction         MarketAction[]
  MarketWatch          MarketWatch[]
  WeeklyDelta          WeeklyDelta[]
  ContentIntelligenceConfig ContentIntelligenceConfig?
  businessProfile      ProjectBusinessProfile?
  competitorFindings   CompetitorFinding[]
  strategyRuns         StrategyRun[]
  ContentStrategy      ContentStrategy[]
  integrations         Integration[]
  socialPosts          SocialPost[]
  gbpFixProposals      GbpFixProposal[]
  competitorChangeAlerts CompetitorChangeAlert[]

  @@index([organizationId])
  growthOpportunities GrowthOpportunity[]
}



/// One row per (organization, metric, billing period). Incremented after work
/// succeeds, so a failed crawl or a failed LLM call never burns the customer's
/// allowance.

/// A question we ask AI assistants on a schedule to see whether they cite the
/// customer. This is the unit the AI Visibility dashboard is built on.
model TrackedPrompt {
  id              String        @id @default(uuid())
  projectId       String
  text            String
  intent          SearchIntent?
  /// Free-form grouping, e.g. "comparison guides".
  cluster         String?
  /// Monthly search volume, when the customer supplies it.
  estimatedVolume Int?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  checks          PromptCheck[]
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, text])
  @@index([projectId, isActive])
}

/// One run of one prompt against one assistant.
model PromptCheck {
  id               String        @id @default(uuid())
  trackedPromptId  String
  assistant        AiAssistant
  checkedAt        DateTime      @default(now())
  /// Whether the customer's own domain appeared in the answer.
  cited            Boolean       @default(false)
  /// 1 = the customer was the first brand named. Null when not cited.
  position         Int?
  /// The customer URL the assistant referenced, when it gave one.
  citedUrl         String?
  /// Tracked competitor domains that appeared in the same answer.
  competitorsCited String[]      @default([])
  /// Trimmed answer text, kept so a customer can see the evidence.
  answerExcerpt    String?
  /// The model that actually answered, e.g. "claude-opus-5".
  model            String?
  /// Populated when the check could not run; `cited` stays false but this
  /// distinguishes "not cited" from "never asked".
  error            String?
  trackedPrompt    TrackedPrompt @relation(fields: [trackedPromptId], references: [id], onDelete: Cascade)

  @@index([trackedPromptId, checkedAt])
  @@index([assistant, checkedAt])
  @@index([checkedAt])
}

/// How a client's website code is reached, so fixes and new content can be
/// written back to it.
model SiteRepository {
  id                   String          @id @default(uuid())
  projectId            String          @unique
  provider             String          @default("github")
  owner                String
  name                 String
  defaultBranch        String          @default("main")
  /// Encrypted with ENCRYPTION_KEY. Never returned by the API.
  accessTokenEncrypted String
  /// "nextjs" | "static-html" | "unknown" — decides which patch strategy runs.
  framework            String          @default("unknown")
  /// Where new content pages are written, e.g. "content/blog" or "src/app".
  contentDir           String?
  /// Off by default: a PR is opened and a human merges it. Turning this on
  /// makes the agent publish to the live site without review.
  autoMerge            Boolean         @default(false)
  lastRunAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  runs                 AutomationRun[]
  project              Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// One end-to-end pass: clone, patch and/or write content, validate, open a PR.
model AutomationRun {
  id             String              @id @default(uuid())
  repositoryId   String
  projectId      String
  kind           AutomationRunKind
  status         AutomationRunStatus @default(PENDING)
  branch         String?
  pullRequestUrl String?
  /// Per-step log so a customer can see exactly what the agent did.
  steps          Json                @default("[]")
  filesChanged   String[]            @default([])
  error          String?
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  repository     SiteRepository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pieces         ContentPiece[]

  @@index([projectId, startedAt])
}

/// A page the strategy said to add, tracked from plan through to live.
model ContentPiece {
  id               String             @id @default(uuid())
  projectId        String
  runId            String?
  kind             ContentPieceKind   @default(ARTICLE)
  status           ContentPieceStatus @default(PLANNED)
  /// The observation this draft was written from, when there is one.
  sourceEvidenceId String?
  title            String
  slug             String
  format           String?
  targetQuery      String?
  rationale        String?
  /// The generated page body (Markdown/MDX), once drafted.
  body             String?
  metaDescription  String?
  generatedByModel String?
  /// Path written in the customer's repository.
  filePath         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run              AutomationRun?     @relation(fields: [runId], references: [id])
  sourceEvidence   Evidence?          @relation(fields: [sourceEvidenceId], references: [id], onDelete: SetNull)

  @@unique([projectId, slug])
  @@index([projectId, status])
}

/// A generated go-to-market plan: market read, SEO roadmap, content plan, and
/// social strategy, grounded in this project's crawl and visibility evidence.
model StrategyReport {
  id               String   @id @default(uuid())
  projectId        String
  /// The evidence the plan was built from, kept so a customer can see the basis
  /// for a recommendation and we can debug a bad one.
  evidence         Json
  content          Json
  generatedByModel String?
  createdAt        DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model OutreachCampaign {
  id         String            @id @default(uuid())
  projectId  String
  name       String
  status     String            @default("ACTIVE")
  sentCount  Int               @default(0)
  replyCount Int               @default(0)
  linkCount  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contacts   OutreachContact[]
}

model OutreachContact {
  id          String           @id @default(uuid())
  campaignId  String
  email       String
  domain      String
  status      String           @default("PENDING")
  lastContact DateTime?
  campaign    OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

/// A rival the customer wants share-of-voice measured against.
/// A tracked competitor.
///
/// Everything beyond `domain` is discovered rather than typed: the operator
/// supplies a URL and the discovery pipeline fills the rest in, recording how
/// confident it is. A field left null means "not discovered yet", never "the
/// competitor does not have one" — the difference matters when deciding whether
/// to re-run discovery.
model CompetitorDomain {
  id             String              @id @default(uuid())
  projectId      String
  domain         String
  label          String?
  /// Business name as published on their own site, when discovered.
  name           String?
  industry       String?
  description    String?
  phone          String?
  /// The name this competitor trades under on Google Maps, which is often not
  /// the name on their website and is what a Places lookup must match.
  mapsName       String?
  /// Channel URL or @handle. Resolved to a channel id at sync time.
  youtubeUrl     String?
  /// Professional (Business/Creator) account handle. Personal accounts cannot
  /// be read by any compliant API, so one stored here may still be unreadable.
  instagramHandle String?
  /// City or service area this competitor actually operates in, which is what
  /// makes a local comparison meaningful.
  city           String?
  /// The Google listing this competitor was matched to, and what it said.
  ///
  /// Stored on the competitor rather than in LocalLocation because that model
  /// is one-per-project and describes the customer's own listing. These are
  /// null until a lookup has run, and null is not zero: a competitor with no
  /// stored rating has not been checked, which is a different statement from
  /// a competitor rated zero.
  placeId          String?
  localRating      Float?
  localReviewCount Int?
  localAddress     String?
  /// When the listing was last read, so a stale figure can be seen as stale.
  localCheckedAt   DateTime?
  /// 0-100, how reliably the discovered identity is believed to be this
  /// competitor. Null until discovery has run. Never assume a match without it.
  confidenceScore Int?
  /// PENDING | ANALYZING | ANALYZED | FAILED
  status         String              @default("PENDING")
  lastAnalyzedAt DateTime?
  nextAnalysisAt DateTime?
  /// The crawled site behind this domain, once it has been crawled at least
  /// once. Shared: two projects tracking the same competitor point at one
  /// Website rather than crawling that third party twice.
  ///
  /// SetNull rather than Cascade — deleting a crawled site must not delete
  /// the competitor the customer added.
  websiteId      String?
  website        Website?            @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  socialAccounts CompetitorAccount[]
  findings       CompetitorFinding[]

  @@unique([projectId, domain])
  @@index([projectId])
  @@index([projectId, status])
}

model SocialPost {
  id             String    @id @default(uuid())
  projectId      String
  platform       String    /// INSTAGRAM | FACEBOOK | YOUTUBE
  postId         String    /// The ID of the post on the platform
  isCompetitor   Boolean   @default(false)
  authorHandle   String    /// The handle that posted this
  content        String?
  url            String?
  publishedAt    DateTime
  likes          Int       @default(0)
  comments       Int       @default(0)
  shares         Int       @default(0)
  views          Int       @default(0)
  engagementRate Float?
  fetchedAt      DateTime  @default(now())
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([platform, postId])
  @@index([projectId, platform, isCompetitor])
}

/// Razorpay retries webhooks aggressively. Storing the delivery id makes
/// handling idempotent so a retried `subscription.charged` cannot roll the
/// billing period forward twice.
model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([eventType, createdAt])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resource       String?
  details        Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}

model LocalLocation {
  id             String         @id @default(uuid())
  projectId      String         @unique
  businessName   String
  address        String
  rating         Float          @default(0)
  reviewCount    Int            @default(0)
  citationsCount Int            @default(0)
  updatedAt      DateTime       @updatedAt
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rankings       LocalRanking[]
}

model GbpFixProposal {
  id            String   @id @default(uuid())
  projectId     String
  field         String   // e.g. "description", "services", "attributes"
  currentValue  String?
  proposedValue String
  rationale     String
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED | PUSHED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model CustomReport {
  id         String   @id @default(uuid())
  projectId  String
  name       String
  frequency  String   @default("MONTHLY")
  recipients String[]
  format     String   @default("PDF")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model LocalReview {
  id              String         @id @default(uuid())
  projectId       String
  authorName      String
  authorPhotoUrl  String?
  rating          Int
  text            String?
  time            String
  relativeTime    String
  aiDraftedReply  String?
  replyStatus     String         @default("PENDING") // PENDING, PUBLISHED
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, replyStatus])
}


model ClientPortalConfig {
  id           String   @id @default(uuid())
  projectId    String   @unique
  customDomain String?
  logoUrl      String?
  themeColor   String?  @default("#2563eb")
  isPublic     Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// What a client actually sells, read off their own website.
///
/// Market Research used to open on a niche picker: nothing happened until the
/// operator classified their own business, which is a question their homepage
/// already answers. This row is that answer — detected once, reused on every
/// page load, and overwritten when an operator corrects it.
model ProjectBusinessProfile {
  id              String   @id @default(uuid())
  projectId       String   @unique
  /// The domain the profile was read from. A project that changes website
  /// gets re-detected rather than keeping a profile for the old one.
  domain          String
  businessName    String
  /// The niche in the client's own terms, specific enough to search on.
  industry        String
  summary         String?
  offerings       String[]
  businessModel   String?
  city            String?
  state           String?
  country         String?
  /// Competitor search scope implied by the location: worldwide | india | maharashtra.
  suggestedRegion String   @default("worldwide")
  seedKeywords    String[]
  /// high | medium | low — low means the site gave us little to go on.
  confidence      String   @default("medium")
  /// Where each fact came from, so a wrong profile can be traced.
  signals         String[]
  /// What the business is trying to achieve. Set by the operator, never
  /// detected: the same site can be run for leads or for brand awareness and
  /// only the owner knows which, yet it changes how every action ranks.
  businessGoal    String?
  /// Who they sell to, in the operator's own words.
  targetAudience  String?
  /// ai | heuristic — how the profile was produced.
  source          String   @default("heuristic")
  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([domain])
}

model MarketIntelligence {
  id               String   @id @default(uuid())
  projectId        String   @unique
  sentimentScore   Float    @default(0.0)
  sentimentSummary String?
  trendingTopics   String[]
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model MonitoringConfig {
  id                  String    @id @default(uuid())
  projectId           String    @unique
  uptimeStatus        String    @default("UP")
  uptimePercentage    Float     @default(99.99)
  avgResponseTimeMs   Int       @default(250)
  lastDowntimeAt      DateTime?
  sslStatus           String    @default("VALID")
  sslExpiresAt        DateTime?
  performanceScore    Int       @default(90)
  mobileScore         Int       @default(85)
  coreWebVitalsStatus String    @default("PASSING")
  updatedAt           DateTime  @updatedAt
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model IntegrationConfig {
  id               String   @id @default(uuid())
  projectId        String   @unique
  gaConnected      Boolean  @default(false)
  gscConnected     Boolean  @default(false)
  gaPropertyId     String?
  gscPropertyId    String?
  updatedAt        DateTime @updatedAt
  hubspotConnected Boolean  @default(false)
  hubspotPortalId  String?
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model LocalRanking {
  id           String        @id @default(uuid())
  locationId   String
  keyword      String
  position     Int
  previousPos  Int?
  searchVolume Int           @default(0)
  updatedAt    DateTime      @updatedAt
  location     LocalLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// How often a verified site is re-crawled on its own schedule.
///
/// Each site is picked up by exactly one cron. The daily, weekly and monthly
/// jobs each used to select *every* verified site, so a single site was
/// re-crawled by all three and the crons multiplied load instead of dividing it.
enum CrawlFrequency {
  OFF
  DAILY
  WEEKLY
  MONTHLY
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}


/// Mirrors the Razorpay subscription lifecycle so we never have to parse
/// free-form strings when deciding whether an organization may use the product.

/// Every metered thing a plan can cap. Kept as an enum so a typo in a service
/// is a compile error rather than a silently uncounted usage.

/// Assistants we report citation share for.
///
/// Only CHATGPT, CLAUDE, and GEMINI can be queried directly through a vendor
/// API. PERPLEXITY, AI_OVERVIEWS, and COPILOT are defined so the dashboard can
/// display them, but no check runs against them until an adapter exists —
/// `PromptCheck.error` records that rather than reporting a fabricated zero.
enum AiAssistant {
  CHATGPT
  CLAUDE
  GEMINI
  PERPLEXITY
  AI_OVERVIEWS
  COPILOT
}

/// What a searcher is trying to do, used to cluster prompts in reporting.
enum SearchIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
}

enum IssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum LinkType {
  INTERNAL
  EXTERNAL
}

enum SchemaType {
  ORGANIZATION
  LOCAL_BUSINESS
  PRODUCT
  ARTICLE
  BREADCRUMB
  FAQ
  REVIEW
  VIDEO
  RECIPE
  EVENT
  OTHER
}

enum FixStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  APPLIED
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  AWAITING_REVIEW
  MERGED
  FAILED
}

enum AutomationRunKind {
  FIXES
  CONTENT
}

/// What the content agent produced. Everything lands in DRAFTED for review;
/// nothing here is published automatically.
enum ContentPieceKind {
  ARTICLE
  BRIEF
  GBP_POST
  FAQ
  REVIEW_REPLY
  LANDING_PAGE_OUTLINE
  SCHEMA_MARKUP
}

enum ContentPieceStatus {
  PLANNED
  DRAFTED
  COMMITTED
  PUBLISHED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// Agent runtime — the evidence spine
//
// Every agent records what it did (AgentRun), what it observed (Evidence), and
// what it concluded (Recommendation). A Recommendation carries a REQUIRED
// foreign key to the Evidence that justifies it, so the database itself rejects
// a conclusion with no proof behind it. This is deliberate: unsupported
// figures presented as analysis are the single failure mode this product
// cannot afford, and a convention would eventually be forgotten.
// ─────────────────────────────────────────────────────────────────────────────

enum AgentKind {
  SEO_AUDITOR
  LOCAL_SEO
  MARKET_INTELLIGENCE
  STRATEGY
  CONTENT
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Where an observation came from. Anything an agent asserts must trace to one
/// of these, so a reader can always answer "how do you know that?".
enum EvidenceSource {
  /// A page returned by our own crawler.
  CRAWL_PAGE
  /// An issue raised by the issue engine against a crawled page.
  CRAWL_ISSUE
  /// Lighthouse / PageSpeed measurement for a page.
  PERFORMANCE
  /// A tracked prompt checked against an AI assistant.
  AI_VISIBILITY_CHECK
  /// A prompt the customer is tracking, independent of any check.
  TRACKED_PROMPT
  /// SERP listing from DataForSEO.
  DATAFORSEO_SERP
  /// Keyword volume / difficulty from DataForSEO.
  DATAFORSEO_KEYWORD
  /// Review text from DataForSEO.
  DATAFORSEO_REVIEW
  /// Google Business Profile listing field (category, hours, photo, service).
  GBP_PROFILE
  /// A review left on the Google Business Profile.
  GBP_REVIEW
  /// Google Search Console query/page row.
  SEARCH_CONSOLE
  /// Google Analytics metric.
  ANALYTICS
}

enum RecommendationHorizon {
  DAYS_30
  DAYS_60
  DAYS_90
}

enum RecommendationEffort {
  LOW
  MEDIUM
  HIGH
}

enum RecommendationImpact {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  DONE
  DISMISSED
}

/// One execution of one agent against one project.
model AgentRun {
  id               String           @id @default(uuid())
  projectId        String
  agent            AgentKind
  status           AgentRunStatus   @default(RUNNING)
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  /// Model that produced the output, when the run used one.
  generatedByModel String?
  /// What the run was given to work with, for reproducibility.
  inputSummary     Json?
  /// Failure reason when status is FAILED.
  error            String?
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence         Evidence[]
  recommendations  Recommendation[]

  @@index([projectId, agent, startedAt])
}

/// A single observation, tied to where it came from and when it was true.
model Evidence {
  id           String           @id @default(uuid())
  projectId    String
  runId        String?
  source       EvidenceSource
  /// Points back to the origin: a URL, a Prisma row id, or an API query.
  reference    String
  /// When the observation was made — not when the row was written. A figure
  /// from a three-month-old crawl should be visibly three months old.
  observedAt   DateTime
  /// One line a human can read without opening the payload.
  summary      String
  /// The raw record, kept so a claim can be re-checked against its source.
  payload      Json?
  createdAt    DateTime         @default(now())
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run          AgentRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// Recommendations for which this is the load-bearing proof.
  primaryFor   Recommendation[] @relation("PrimaryEvidence")
  /// Recommendations this additionally supports.
  supports     Recommendation[] @relation("SupportingEvidence")
  ContentPiece ContentPiece[]

  @@index([projectId, source, observedAt])
  @@index([runId])
}

/// A conclusion an agent reached, and the plan entry it becomes.
model Recommendation {
  id                 String                @id @default(uuid())
  projectId          String
  runId              String
  agent              AgentKind
  title              String
  /// Why this matters, in the customer's terms.
  rationale          String
  horizon            RecommendationHorizon
  effort             RecommendationEffort
  impact             RecommendationImpact
  /// Who is expected to do it — a role or team label, e.g. "Developer".
  owner              String
  status             RecommendationStatus  @default(PROPOSED)
  /// NOT NULL by design. There is no way to persist a recommendation without
  /// at least one piece of evidence behind it.
  primaryEvidenceId  String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run                AgentRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  primaryEvidence    Evidence              @relation("PrimaryEvidence", fields: [primaryEvidenceId], references: [id], onDelete: Restrict)
  supportingEvidence Evidence[]            @relation("SupportingEvidence")

  @@index([projectId, horizon, status])
  @@index([runId])
}

// ─────────────────────────────────────────────────────────────────────────────
// GrowthX Market Research
//
// Cited market research joined to a client's own crawl, competitors, tracked
// prompts and AI-visibility history.
//
// Every table carries BOTH organizationId and projectId. The project alone
// would be enough to scope a query, but carrying the organization means a
// mis-scoped query fails closed against the tenant boundary rather than
// leaking across it, and it keeps the guard checkable in one place.
// ─────────────────────────────────────────────────────────────────────────────

enum ResearchIntent {
  MARKET_TREND
  COMPETITOR_COMPARISON
  CUSTOMER_INSIGHT
  AI_VISIBILITY_GAP
  CONTENT_OPPORTUNITY
  STRATEGIC_RECOMMENDATION
}

enum ResearchRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Where a piece of evidence came from. Drives the badge in the source drawer.
enum ResearchSourceType {
  PUBLIC_WEB
  CLIENT_WEBSITE
  UPLOADED_FILE
  AI_VISIBILITY_CHECK
  INTEGRATION_DATA
}

enum ResearchConfidence {
  HIGH
  MEDIUM
  LOW
}

/// A statement the model made. VERIFIED must cite sources; INFERENCE is the
/// model reasoning beyond them and is labelled as such everywhere it appears.
enum ResearchClaimKind {
  VERIFIED
  INFERENCE
}

enum MarketActionType {
  CONTENT_BRIEF
  PAGE_REFRESH
  TECHNICAL_TASK
  TRACK_PROMPT
  COMPETITOR_WATCH
  OUTREACH_OPPORTUNITY
}

enum MarketActionStatus {
  PROPOSED
  APPROVED
  REJECTED
  CONVERTED
}

enum MarketWatchKind {
  COMPETITOR
  TOPIC
}

enum ResearchMessageRole {
  USER
  ASSISTANT
}

/// A conversation. Follow-ups reuse the thread so context stays project scoped.
model MarketResearchThread {
  id             String                  @id @default(uuid())
  organizationId String
  projectId      String
  title          String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages       MarketResearchMessage[]
  runs           MarketResearchRun[]

  @@index([organizationId, projectId, updatedAt])
}

model MarketResearchMessage {
  id             String               @id @default(uuid())
  threadId       String
  organizationId String
  projectId      String
  role           ResearchMessageRole
  content        String
  /// Set on assistant messages: the run that produced them.
  runId          String?
  createdAt      DateTime             @default(now())
  thread         MarketResearchThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([organizationId, projectId])
}

/// One execution of the research pipeline, with everything needed to audit it.
model MarketResearchRun {
  id               String               @id @default(uuid())
  threadId         String
  organizationId   String
  projectId        String
  question         String
  intent           ResearchIntent?
  status           ResearchRunStatus    @default(RUNNING)
  /// Whether the caller asked for the premium deep-research model.
  deepResearch     Boolean              @default(false)
  /// The plan produced before retrieval.
  plan             Json?
  /// The validated structured answer returned to the client.
  answer           Json?
  confidence       ResearchConfidence?
  /// Per-step model usage: which model ran which step, and what it cost.
  modelUsage       Json?
  inputTokens      Int                  @default(0)
  outputTokens     Int                  @default(0)
  estimatedCostUsd Float?
  error            String?
  startedAt        DateTime             @default(now())
  finishedAt       DateTime?
  thread           MarketResearchThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sources          ResearchSource[]
  claims           ResearchClaim[]
  opportunities    MarketOpportunity[]
  actions          MarketAction[]

  @@index([organizationId, projectId, startedAt])
  @@index([threadId])
}

/// One retrieved source. The model may only cite keys that exist here for its
/// own run, which is what makes "no invented URLs" checkable rather than hoped for.
model ResearchSource {
  id             String             @id @default(uuid())
  runId          String
  organizationId String
  projectId      String
  /// Stable handle used in the model's citations, e.g. "source_1".
  sourceKey      String
  type           ResearchSourceType
  url            String?
  /// For client pages, uploads and internal records.
  internalDocId  String?
  title          String
  publisher      String?
  publishedAt    DateTime?
  retrievedAt    DateTime           @default(now())
  excerpt        String
  /// 0-1. How much weight this source should carry.
  qualityScore   Float              @default(0.5)
  createdAt      DateTime           @default(now())
  run            MarketResearchRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  claims         ResearchClaim[]    @relation("ClaimCitations")

  @@unique([runId, sourceKey])
  @@index([organizationId, projectId])
}

model ResearchClaim {
  id             String            @id @default(uuid())
  runId          String
  organizationId String
  projectId      String
  kind           ResearchClaimKind
  text           String
  /// Why the model believes it, for inferences.
  reasoning      String?
  createdAt      DateTime          @default(now())
  run            MarketResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  citations      ResearchSource[]  @relation("ClaimCitations")

  @@index([runId, kind])
  @@index([organizationId, projectId])
}

/// A citation/visibility gap the research surfaced.
model MarketOpportunity {
  id                  String             @id @default(uuid())
  runId               String?
  organizationId      String
  projectId           String
  topic               String
  gap                 String
  competitorsWinning  String[]
  recommendedResponse String
  impact              ResearchConfidence @default(MEDIUM)
  effort              ResearchConfidence @default(MEDIUM)
  createdAt           DateTime           @default(now())
  run                 MarketResearchRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions             MarketAction[]

  @@index([organizationId, projectId, createdAt])
}

/// A recommendation awaiting a human decision. Nothing here executes on its own.
model MarketAction {
  id                  String               @id @default(uuid())
  organizationId      String
  projectId           String
  runId               String?
  opportunityId       String?
  type                MarketActionType
  title               String
  description         String
  expectedImpact      String?
  confidence          ResearchConfidence   @default(MEDIUM)
  status              MarketActionStatus   @default(PROPOSED)
  requiresApproval    Boolean              @default(true)
  approvedByUserId    String?
  approvedAt          DateTime?
  /// Id of the record this became once converted (content piece, prompt, etc).
  convertedToId       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  run                 MarketResearchRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  opportunity         MarketOpportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  MarketActionOutcome MarketActionOutcome?

  @@index([organizationId, projectId, status])
}

/// A competitor or topic to monitor between research runs.
model MarketWatch {
  id             String          @id @default(uuid())
  organizationId String
  projectId      String
  kind           MarketWatchKind
  /// Domain for COMPETITOR, phrase for TOPIC.
  value          String
  isActive       Boolean         @default(true)
  lastCheckedAt  DateTime?
  createdAt      DateTime        @default(now())
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, value])
  @@index([organizationId, projectId, isActive])
}

/// Embedding index over client-owned text (crawled pages, saved reports, briefs).
///
/// The vector is a plain Float[] and similarity is computed over this project's
/// own rows. pgvector would be faster, but it is an extension we cannot verify
/// on every deployment target, and a project's corpus is small enough that an
/// exact scan is both correct and fast. Scoping the scan to one project also
/// makes a cross-tenant match structurally impossible.
model ResearchEmbedding {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  /// What was embedded: CRAWL_PAGE, REPORT, BRIEF, UPLOAD.
  kind           String
  /// Id or URL of the underlying record.
  refId          String
  title          String
  excerpt        String
  vector         Float[]
  model          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, kind, refId])
  @@index([organizationId, projectId, kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — measurement and monitoring
//
// Closes the loop: an approved action that became real work gets a visibility
// snapshot at conversion, and another one later, so the agency can see what
// moved afterwards.
// ─────────────────────────────────────────────────────────────────────────────

enum OutcomeStatus {
  /// Baseline captured; not enough time has passed to re-measure.
  PENDING
  /// A follow-up measurement exists.
  MEASURED
  /// Re-measured, but the project has too little visibility data to compare.
  INCONCLUSIVE
}

/// Before-and-after visibility for one converted action.
///
/// Deliberately records movement, not attribution. Citation share moves for
/// many reasons at once — competitors publishing, assistants changing, other
/// work shipping in the same week — so this stores what changed and leaves
/// causation to the human reading it. Claiming the action caused the delta
/// would be the same class of invention the citation rules exist to prevent.
model MarketActionOutcome {
  id             String        @id @default(uuid())
  actionId       String        @unique
  organizationId String
  projectId      String
  status         OutcomeStatus @default(PENDING)

  /// Position when the work was created.
  baselineAt               DateTime
  baselineCitationSharePct Float?
  baselineAveragePosition  Float?
  baselineTrackedPrompts   Int      @default(0)

  /// Position at the most recent re-measurement.
  measuredAt       DateTime?
  citationSharePct Float?
  averagePosition  Float?

  /// Percentage points moved since baseline. Null until re-measured.
  deltaPt   Float?
  /// What could not be established, e.g. "no prompts tracked in this period".
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  action    MarketAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, status])
}

/// A generated weekly summary for one client.
model WeeklyDelta {
  id               String   @id @default(uuid())
  organizationId   String
  projectId        String
  periodStart      DateTime
  periodEnd        DateTime
  /// The rendered summary: what changed, movement, competitors, next action.
  content          Json
  generatedByModel String?
  createdAt        DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, periodStart])
  @@index([organizationId, projectId, periodEnd])
}

// ─────────────────────────────────────────────────────────────────────────────
// Content Intelligence & Creative Engine
//
// Every model carries organizationId + projectId for double-fence tenant
// isolation, matching the pattern established in MarketResearchThread.
//
// The flow: competitors → competitor content → classification → patterns →
// gaps → strategy → content calendar → campaigns → creators → publishing →
// analytics → company brain learning.
// ─────────────────────────────────────────────────────────────────────────────

/// Per-project configuration for the Content Intelligence module.
model ContentIntelligenceConfig {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String   @unique
  /// Industry skill applied: JEWELLERY | REAL_ESTATE | RESTAURANT | FASHION | ECOMMERCE | SAAS | GENERIC
  industrySkill  String   @default("GENERIC")
  /// Automation level: MANUAL | SEMI_AUTO | AUTO
  automationLevel String  @default("MANUAL")
  /// Posting frequency preference: DAILY | 3X_WEEK | WEEKLY
  postingFrequency String? 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
}

/// Social account handles for one competitor on one platform.
model CompetitorAccount {
  id                 String            @id @default(uuid())
  organizationId     String
  projectId          String
  competitorId       String
  competitor         CompetitorDomain  @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  platform           String            /// INSTAGRAM | FACEBOOK | YOUTUBE | TIKTOK | TWITTER | LINKEDIN
  handle             String            /// @handle or channel id
  profileUrl         String?
  displayName        String?
  followerCount      Int?
  website            String?
  businessName       String?
  location           String?
  industry           String?
  discoverySource    String?           /// WEBSITE_CRAWL | MANUAL | SEARCH
  verificationStatus String?           /// VERIFIED | UNVERIFIED | SUGGESTED
  matchConfidence    Int?              /// 0-100 match confidence
  isActive           Boolean           @default(true)
  lastSyncedAt       DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  content            CompetitorContent[]

  @@unique([projectId, platform, handle])
  @@index([organizationId, projectId])
  @@index([competitorId])
}

/// Normalized content item from any competitor on any platform.
model CompetitorContent {
  id                  String                  @id @default(uuid())
  organizationId      String
  projectId           String
  accountId           String
  platform            String                  /// INSTAGRAM | FACEBOOK | YOUTUBE
  contentType         String?                 /// POST | REEL | VIDEO | STORY | CAROUSEL | SHORT
  publishedAt         DateTime?
  caption             String?
  title               String?
  description         String?
  hashtags            String[]                @default([])
  mediaUrl            String?
  thumbnailUrl        String?
  contentUrl          String?
  duration            Int?                    /// Video duration in seconds
  transcript          String?                 /// Full speech transcript
  transcriptSegments  Json?                   /// [{ start, end, text, type }]
  ocrText             String?                 /// Extracted on-screen video frame text
  scenes              Json?                   /// [{ start, end, description, visualFormat, objects }]
  hookAnalysis        Json?                   /// { hook, hookType, durationSeconds, strength }
  structureAnalysis   Json?                   /// { hookDuration, intro, problem, solution, ctaPlacement, conclusion }
  whyItWorks          String?                 /// Strategic teardown of why this content succeeds
  dataSourceType      String?                 /// PUBLIC_DATA | AUTHORIZED_DATA | ESTIMATED_DATA | AI_INFERENCE
  confidenceLevel     String?                 /// HIGH | MEDIUM | LOW
  likesCount          Int?
  commentsCount       Int?
  sharesCount         Int?
  viewsCount          Int?
  savesCount          Int?
  engagementAvailable Boolean                 @default(false)
  /// AI-detected topics, format, style, objects (stored separately in classification)
  rawMetadata         Json?
  createdAt           DateTime                @default(now())
  account             CompetitorAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  classification      ContentClassification?
  patternLinks        PatternContentLink[]

  @@index([organizationId, projectId, platform])
  @@index([accountId, publishedAt])
}

/// AI-generated classification for one piece of competitor content.
model ContentClassification {
  id                  String           @id @default(uuid())
  contentId           String           @unique
  /// Content category / pillar: EDUCATIONAL | PROMOTIONAL | PRODUCT | LIFESTYLE | BEHIND_SCENES | TESTIMONIAL | etc.
  contentCategory     String?
  contentPillar       String?
  topic               String?
  subtopic            String?
  format              String?
  /// Visual format: STATIC | CAROUSEL | REEL | SHORT_VIDEO | LONG_VIDEO | STORY
  visualFormat        String?
  /// Detected topics as array
  detectedTopics      String[]         @default([])
  /// Visual objects detected: PRODUCT | MODEL | CELEBRITY | FLOWERS | WEDDING | OUTDOOR | etc.
  detectedObjects     String[]         @default([])
  /// Detected storytelling style
  storytellingStyle   String?
  /// Detected hook type: QUESTION | PROBLEM | CURIOSITY | STATISTIC | MISTAKE | WARNING | BEFORE_AFTER | STRONG_CLAIM | STORY | LIST | COMPARISON | DIRECT_STATEMENT
  hookType            String?
  /// Detected CTA type: BOOK_CONSULTATION | VISIT_WEBSITE | CALL | DM | COMMENT | SUBSCRIBE | FOLLOW | BUY | LEARN_MORE | DOWNLOAD | NONE
  ctaType             String?
  ctaText             String?
  audience            String?
  searchIntent        String?
  marketingIntent     String?
  funnelStage         String?          /// AWARENESS | CONSIDERATION | CONVERSION | RETENTION
  tone                String?
  language            String?          @default("en")
  visualStyle         String?
  contentObjective    String?
  confidence          Int?             @default(90)
  /// Overall creative style score 0-10
  creativityScore     Float?
  classifiedByModel   String?
  classifiedAt        DateTime         @default(now())
  content             CompetitorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

/// A creative pattern detected across multiple competitors' content.
model CreativePattern {
  id                   String               @id @default(uuid())
  organizationId       String
  projectId            String
  name                 String
  description          String
  /// Platforms where this pattern appears
  platforms            String[]             @default([])
  /// Content categories exhibiting this pattern
  contentCategories    String[]             @default([])
  /// Visual objects central to this pattern
  keyVisualElements    String[]             @default([])
  /// Detected storytelling approach
  storytellingApproach String?
  /// Detected CTA type
  ctaType              String?
  /// How many content pieces use this pattern
  frequency            Int                  @default(0)
  /// 0-100: 100 = every competitor uses it
  marketSaturation     Int                  @default(0)
  /// 0-100: 100 = huge untapped opportunity
  opportunityScore     Int                  @default(50)
  detectedAt           DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  patternLinks         PatternContentLink[]
  gaps                 ContentGap[]         @relation("GapPattern")

  @@index([organizationId, projectId, opportunityScore])
}

/// Junction: which content items exemplify a pattern.
model PatternContentLink {
  id        String           @id @default(uuid())
  patternId String
  contentId String
  pattern   CreativePattern  @relation(fields: [patternId], references: [id], onDelete: Cascade)
  content   CompetitorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([patternId, contentId])
}

/// A content gap identified between customer content and competitor patterns.
model ContentGap {
  id                      String           @id @default(uuid())
  organizationId          String
  projectId               String
  patternId               String?
  /// SATURATED | COMPETITOR_WINNING | CUSTOMER_WINNING | CUSTOMER_MISSING | MARKET_GAP | EMERGING | DIFFERENTIATION
  gapType                 String
  title                   String
  description             String
  competitionLevel        String           @default("MEDIUM")   /// LOW | MEDIUM | HIGH
  opportunityScore        Int              @default(50)
  businessRelevanceScore  Int?             @default(85)
  searchOpportunityScore  Int?             @default(80)
  competitorEvidenceScore Int?             @default(85)
  contentGapScore         Int?             @default(90)
  confidenceScore         Int?             @default(88)
  effortLevel             String?          @default("MEDIUM")  /// LOW | MEDIUM | HIGH
  relatedKeywords         String[]         @default([])
  platforms               String[]         @default([])
  suggestedFormats        String[]         @default([])
  /// Recommended action
  recommendedAction       String?
  status                  String           @default("OPEN")     /// OPEN | ACTIONED | DISMISSED
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  pattern                 CreativePattern? @relation("GapPattern", fields: [patternId], references: [id], onDelete: SetNull)
  CalendarItem            ContentCalendarItem[]

  @@index([organizationId, projectId, gapType])
  @@index([projectId, status])
}

/// Change detection alert when a competitor shifts strategy, spikes velocity, or launches a campaign.
model CompetitorChangeAlert {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  competitorId   String?
  accountHandle  String?
  alertType      String   /// VELOCITY_SURGE | NEW_PILLAR | NEW_CAMPAIGN | FORMAT_SHIFT | WINNING_CONTENT
  severity       String   @default("INFO") /// INFO | WARNING | CRITICAL
  title          String
  description    String
  metricChange   String?
  detectedAt     DateTime @default(now())
  status         String   @default("ACTIVE") /// ACTIVE | DISMISSED | ACTIONED
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, status])
  @@index([projectId, detectedAt])
}

/// AI-generated content strategy for a project.
model ContentStrategy {
  id                   String   @id @default(uuid())
  organizationId       String
  projectId            String
  title                String   @default("Content Strategy")
  /// Strategy document as structured JSON
  content              Json
  /// Dynamic content pillars (array of {pillar, pct, rationale})
  contentPillars       Json?
  /// Posting frequency per platform
  platformFrequency    Json?
  /// Campaign recommendations
  campaignIdeas        Json?
  /// Creator strategy
  creatorStrategy      String?
  generatedByModel     String?
  industrySkill        String?
  status               String   @default("DRAFT")   /// DRAFT | APPROVED | ARCHIVED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaigns            Campaign[]

  @@index([organizationId, projectId, createdAt])
}

/// A content calendar item (one planned or published piece of social content).
model ContentCalendarItem {
  id                String   @id @default(uuid())
  organizationId    String
  projectId         String
  campaignId        String?
  gapId             String?
  platform          String                  /// INSTAGRAM | FACEBOOK | YOUTUBE | WHATSAPP | WEBSITE
  contentType       String                  /// POST | REEL | CAROUSEL | VIDEO | BLOG | STORY
  contentPillar     String?                 /// PRODUCT | EDUCATIONAL | LIFESTYLE | CREATOR | PROMOTIONAL
  title             String
  caption           String?
  hook              String?
  cta               String?
  hashtags          String[]  @default([])
  visualBrief       String?
  scheduledFor      DateTime?
  publishedAt       DateTime?
  status            String    @default("DRAFT") /// DRAFT | REVIEW | APPROVED | SCHEDULED | PUBLISHED | FAILED
  approvalMode      String    @default("APPROVAL")  /// AUTO | APPROVAL | CONTROLLED
  generatedByModel  String?
  creatorId         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  gap               ContentGap? @relation(fields: [gapId], references: [id], onDelete: SetNull)
  campaign          Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  metrics           SocialMetric[]

  @@index([organizationId, projectId, scheduledFor])
  @@index([projectId, status])
  @@index([campaignId])
}

/// A campaign workspace grouping strategy → content → creators → publishing.
model Campaign {
  id                String    @id @default(uuid())
  organizationId    String
  projectId         String
  strategyId        String?
  name              String
  objective         String?
  productFocus      String?
  targetAudience    String?
  budget            Float?
  startDate         DateTime?
  endDate           DateTime?
  platforms         String[]  @default([])
  status            String    @default("PLANNING")  /// PLANNING | ACTIVE | PAUSED | COMPLETED | CANCELLED
  approvalMode      String    @default("APPROVAL")
  /// AI-generated campaign brief as JSON
  brief             Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  strategy          ContentStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  calendarItems     ContentCalendarItem[]
  creatorMatches    CreatorMatch[]

  @@index([organizationId, projectId, status])
}

/// A creator or model in the CRM.
model Creator {
  id                String          @id @default(uuid())
  organizationId    String
  /// Creators are org-level (can be matched to multiple projects)
  name              String
  handle            String?
  platform          String?         /// INSTAGRAM | YOUTUBE | TIKTOK | etc.
  profileUrl        String?
  email             String?
  phone             String?
  location          String?
  category          String?         /// MODEL | INFLUENCER | CELEBRITY | UGC_CREATOR | PHOTOGRAPHER
  industry          String?
  followerCount     Int?
  engagementRate    Float?
  averageBudget     Float?
  currency          String          @default("INR")
  notes             String?
  tags              String[]        @default([])
  status            String          @default("ACTIVE")  /// ACTIVE | INACTIVE | BLACKLISTED
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  matches           CreatorMatch[]
  outreach          CreatorOutreach[]

  @@index([organizationId])
  @@index([organizationId, category])
}

/// AI-scored match between a creator and a campaign.
model CreatorMatch {
  id                String   @id @default(uuid())
  organizationId    String
  projectId         String
  campaignId        String
  creatorId         String
  matchScore        Int      /// 0-100
  /// Why this score was given (JSON breakdown: brand fit, industry fit, etc.)
  scoreBreakdown    Json?
  /// Whether customer shortlisted / selected
  status            String   @default("SUGGESTED")  /// SUGGESTED | SHORTLISTED | SELECTED | REJECTED
  createdAt         DateTime @default(now())
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator           Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorId])
  @@index([organizationId, projectId])
}

/// Creator outreach pipeline record.
model CreatorOutreach {
  id                 String    @id @default(uuid())
  organizationId     String
  projectId          String
  creatorId          String
  campaignId         String?
  subject            String?
  messageBody        String?
  channel            String    @default("EMAIL")   /// EMAIL | INSTAGRAM_DM | WHATSAPP | MANUAL
  /// DISCOVERED | SHORTLISTED | CONTACTED | INTERESTED | NEGOTIATING | CONFIRMED | CAMPAIGN_ACTIVE | COMPLETED | PERFORMANCE_REVIEWED
  pipelineStage      String    @default("DISCOVERED")
  contactedAt        DateTime?
  responseAt         DateTime?
  responseText       String?
  agreedBudget       Float?
  contractStatus     String?   /// PENDING | SIGNED | DECLINED
  notes              String?
  approvedToSend     Boolean   @default(false)
  sentAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  creator            Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, pipelineStage])
  @@index([creatorId])
}

/// Customer's own connected social account for publishing.
model SocialAccount {
  id                 String    @id @default(uuid())
  organizationId     String
  projectId          String
  platform           String                 /// INSTAGRAM | FACEBOOK | YOUTUBE
  accountId          String?                /// Platform's own account/page id
  accountName        String?
  handle             String?
  accessToken        String?                /// Encrypted
  refreshToken       String?                /// Encrypted
  tokenExpiresAt     DateTime?
  scopes             String[]  @default([])
  status             String    @default("DISCONNECTED")  /// CONNECTED | DISCONNECTED | EXPIRED | ERROR
  lastPublishedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([projectId, platform])
  @@index([organizationId, projectId])
}

/// Performance metrics for one published calendar item.
model SocialMetric {
  id             String              @id @default(uuid())
  organizationId String
  projectId      String
  calendarItemId String
  platform       String
  fetchedAt      DateTime            @default(now())
  reach          Int?
  impressions    Int?
  likes          Int?
  comments       Int?
  shares         Int?
  saves          Int?
  clicks         Int?
  views          Int?
  websiteClicks  Int?
  leads          Int?
  engagementRate Float?
  /// Whether these are verified API metrics or modelled estimates
  isVerified     Boolean             @default(false)
  calendarItem   ContentCalendarItem @relation(fields: [calendarItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, fetchedAt])
  @@index([calendarItemId])
}


/// One customer's connection to one external data source.
///
/// Tokens are stored encrypted (see token-crypto.ts) — a refresh token is a
/// long-lived key to a customer's Google data, and these columns were
/// previously plaintext.
model Integration {
  id           String   @id @default(uuid())
  projectId    String
  provider     String   // search_console | analytics | business_profile | google_business
  /// AES-256-GCM ciphertext, never the raw token.
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?

  /// The Google account that authorized this, for showing whose data it is.
  /// An email, not a token — safe to display.
  googleAccountEmail String?
  /// Scopes Google actually granted, which can be narrower than those asked
  /// for: a customer may untick one on the consent screen, and the connector
  /// has to find out before a call fails rather than after.
  grantedScopes String[] @default([])

  /// What the customer picked after authorizing — a GSC property, a GA4
  /// property, a GBP location. Null until they choose, which is a real state:
  /// authorized but not yet usable.
  selectedResourceId   String?
  /// Human-readable form of the same thing, for the UI.
  selectedResourceName String?

  /// CONNECTED | NEEDS_SELECTION | NEEDS_REAUTH | ERROR | DISCONNECTED
  ///
  /// Held rather than inferred, because "the token expired and the refresh
  /// failed" is not visible from the row's other columns and is exactly what
  /// the customer needs told: one broken integration must show as broken
  /// without making the rest of the dashboard look broken too.
  status       String   @default("NEEDS_SELECTION")
  /// Why, when status is ERROR or NEEDS_REAUTH. Shown to the customer, so it
  /// must never carry a token or a raw API payload.
  statusMessage String?

  lastSyncedAt DateTime?
  nextSyncAt   DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditEvents  IntegrationAuditEvent[]

  @@unique([projectId, provider])
  @@index([projectId])
  @@index([status])
}

/// An append-only record of what happened to a connection.
///
/// Connecting, disconnecting and reauthorizing all change who can read a
/// customer's Google data, so each one is recorded with who did it. Kept
/// separate from the Integration row because that row is overwritten on every
/// token refresh and an audit trail that can be overwritten is not one.
model IntegrationAuditEvent {
  id            String   @id @default(uuid())
  integrationId String
  projectId     String
  /// CONNECTED | RESOURCE_SELECTED | REFRESHED | REAUTH_REQUIRED | SYNC_FAILED | DISCONNECTED
  event         String
  /// The account that performed it, where a person did. Sync and refresh have
  /// no actor, which is itself worth being able to tell apart.
  actorUserId   String?
  /// Never a token, never a raw response — this is readable by anyone with
  /// access to the project.
  detail        String?
  createdAt     DateTime @default(now())
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([integrationId, createdAt])
}


/// One row of Google Search Console performance data.
///
/// The spec sketches ten separate entities — GSCQuery, GSCPage, GSCCountry,
/// GSCDevice and so on. This is one table instead, because that is the shape
/// the API actually returns: a Search Analytics response is rows keyed by
/// whichever dimension tuple was requested, and the metrics are identical
/// across all of them. Splitting by dimension would mean five copies of the
/// same sync, fetch and aggregation code, and it would make the query-and-page
/// grain — the one that links a search term to the page that answered it, and
/// later to a GA4 conversion — need a sixth table joining the others.
///
/// `grain` says which dimensions this row is keyed by, so a query total and a
/// query-on-one-page row can never be summed together by accident.
model GscDailyMetric {
  id         String   @id @default(uuid())
  projectId  String
  /// The GSC property this came from, kept on the row so a project that
  /// switches property does not silently blend two sites' history.
  propertyId String
  /// The day, as Google reports it. GSC works in PST regardless of where the
  /// business is, so this is stored as the date string Google returned rather
  /// than a timestamp that a timezone conversion could shift by a day.
  date       DateTime @db.Date

  /// TOTAL | QUERY | PAGE | QUERY_PAGE | COUNTRY | DEVICE
  grain      String
  query      String?
  page       String?
  country    String?
  device     String?

  clicks      Int
  impressions Int
  /// Stored as Google returns it — a ratio, not a percentage. Recomputing it
  /// from clicks/impressions would disagree with the Search Console UI on rows
  /// where Google anonymised rare queries out of the totals.
  ctr         Float
  /// Average position across impressions. Cannot be summed, only re-averaged
  /// weighted by impressions.
  position    Float

  createdAt DateTime @default(now())

  /// One row per property, day and dimension tuple. This is what makes a
  /// re-sync of an already-fetched day an upsert rather than a duplicate —
  /// Google restates recent days as data finalises, so the same day is
  /// deliberately fetched more than once.
  @@unique([propertyId, date, grain, query, page, country, device])
  @@index([projectId, grain, date])
  @@index([projectId, grain, clicks])
  @@index([projectId, page])
}

/// One run of a data-source sync.
///
/// Separate from the Integration row because that is overwritten constantly
/// and a failure history that gets overwritten is not one. This is what the
/// Data Health page reads.
model DataSyncJob {
  id        String   @id @default(uuid())
  projectId String
  /// search_console | analytics | business_profile
  provider  String

  /// RUNNING | SUCCEEDED | PARTIAL | FAILED
  status    String   @default("RUNNING")
  /// The window actually requested, so a gap in coverage is visible rather
  /// than being inferred from what happens to be in the fact table.
  rangeStart DateTime? @db.Date
  rangeEnd   DateTime? @db.Date

  rowsWritten Int      @default(0)
  /// PARTIAL exists because a sync that got three of four dimensions is worth
  /// keeping and worth flagging; recording it as SUCCEEDED hides a gap and as
  /// FAILED throws away real data.
  errorMessage String?

  startedAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([projectId, provider, startedAt])
}

/// A single thing the customer could do, from any source.
///
/// The product already has MarketOpportunity (from a research run) and
/// ContentGap (from social patterns), each shaped for the engine that made it
/// and neither carrying evidence, effort or a dismissal. This is the unified
/// surface: search, competitor, website, local and analytics findings in one
/// list a person can work through.
///
/// Not an engine. Nothing here analyses anything — detectors owned by the
/// existing engines write rows, and this is where they land.
model GrowthOpportunity {
  id             String @id @default(uuid())
  organizationId String
  projectId      String

  /// Stable identity across detection runs, derived from source, category and
  /// subject. Detection re-runs daily, and without this the same finding
  /// would either duplicate or come back OPEN after the customer dismissed
  /// it — the fastest way to make the list worthless.
  fingerprint String

  /// SEARCH_CONSOLE | COMPETITOR | WEBSITE | ANALYTICS | LOCAL | MARKET
  source   String
  /// SEO | CONTENT | LOCAL | TECHNICAL | MARKETING | BUSINESS | COMPETITOR
  category String

  title            String
  summary          String
  /// What this claim rests on: [{ label, value, source }]. Every row carries
  /// its evidence because a recommendation nobody can check is a guess with
  /// better formatting.
  evidence         Json
  recommendedAction String

  /// HIGH | MEDIUM | LOW. Deliberately a band, not a currency figure —
  /// without reliable revenue data attached to a page, a number would be
  /// invented precision.
  potential  String @default("MEDIUM")
  effort     String @default("MEDIUM")
  /// 0-100, how much the underlying evidence supports the claim.
  confidence Int    @default(50)
  /// Derived from potential, confidence and effort so the list can be ordered
  /// without recomputing per request.
  priority   Float  @default(0)

  /// Pages this concerns, where it concerns specific pages.
  affectedPages String[] @default([])

  /// OPEN | ACTIONED | DISMISSED
  status      String    @default("OPEN")
  dismissedAt DateTime?

  detectedAt DateTime @default(now())
  /// Refreshed each time detection still finds it. A row whose lastSeenAt has
  /// stopped moving is a finding that resolved itself, which is worth being
  /// able to tell from one nobody has looked at.
  lastSeenAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, fingerprint])
  @@index([projectId, status, priority])
  @@index([projectId, source])
  @@index([organizationId, projectId])
}

/// One row of Google Analytics 4 data.
///
/// Same shape as GscDailyMetric and for the same reason: the GA4 Data API
/// returns rows keyed by whichever dimensions were requested, so a table per
/// dimension would be several copies of one sync.
///
/// The metrics are nullable rather than defaulted to zero, and that is the
/// important part. A great many GA4 properties have no conversion tracking
/// configured and no revenue at all; storing those as 0 makes "not measured"
/// indistinguishable from "measured, and it was none", and every screen above
/// would then report a real business as having zero conversions.
model Ga4DailyMetric {
  id         String   @id @default(uuid())
  projectId  String
  /// The GA4 property, kept on the row so switching property does not blend
  /// two sites' history.
  propertyId String
  date       DateTime @db.Date

  /// TOTAL | LANDING_PAGE | CHANNEL | COUNTRY | DEVICE
  grain       String
  landingPage String?
  channel     String?
  country     String?
  device      String?

  users       Int
  sessions    Int
  /// 0-1 as GA4 reports it.
  engagementRate Float
  /// Null when the property has no key events configured — not zero.
  conversions Int?
  /// Null unless ecommerce or a revenue-bearing event is set up.
  revenue     Float?

  createdAt DateTime @default(now())

  @@unique([propertyId, date, grain, landingPage, channel, country, device])
  @@index([projectId, grain, date])
  @@index([projectId, landingPage])
}

// ─────────────────────────────────────────── Aiva Voice Agent

/// One voice conversation session (one activation of the voice panel).
model VoiceSession {
  id        String          @id @default(uuid())
  userId    String
  orgId     String
  projectId String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  VoiceMessage[]
  toolCalls AgentToolCall[]

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
}

/// One utterance (user or assistant) within a voice session.
model VoiceMessage {
  id        String       @id @default(uuid())
  sessionId String
  /// "user" or "assistant"
  role      String
  content   String
  createdAt DateTime     @default(now())
  session   VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/// One tool invocation triggered by the voice agent during a session.
model AgentToolCall {
  id        String       @id @default(uuid())
  sessionId String
  toolName  String
  input     Json
  output    Json?
  /// PENDING | SUCCESS | FAILED | CANCELLED
  status    String       @default("PENDING")
  errorMsg  String?
  createdAt DateTime     @default(now())
  session   VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([toolName, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Competitor-to-Action Engine
//
// The product already collects plenty of competitor signal. What it could not
// do was answer "so what should this business do next, and on what evidence?"
// These three models are that missing layer: an observation, a run that reads
// observations, and an action a person can actually pick up.
//
// The hard rule everywhere below is that a recommendation cannot exist without
// the evidence that produced it. An action links to the findings behind it, a
// finding links to the URL it was read from and the date it was read, and
// nothing is stored that was not observed.
// ─────────────────────────────────────────────────────────────────────────────

/// Which surface a finding was observed on.
enum FindingCategory {
  TECHNICAL_SEO
  CONTENT_GAP
  LOCAL_SEO
  GOOGLE_BUSINESS_PROFILE
  YOUTUBE
  INSTAGRAM
  AI_SEARCH
}

/// How much weight a finding can carry.
///
/// HIGH is a fact read directly from a page or an API. MEDIUM is a sound
/// inference from those facts. LOW is a signal worth showing but not worth
/// acting on alone — it is never enough on its own to raise an action above
/// MEDIUM priority.
enum FindingConfidence {
  HIGH
  MEDIUM
  LOW
}

enum ActionPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

/// Who should pick the action up. Shown so a plan can be handed out rather
/// than read.
enum ActionOwner {
  FOUNDER
  MARKETER
  SEO_SPECIALIST
  DESIGNER
  DEVELOPER
}

enum ActionStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

/// One observed signal, with everything needed to check it.
///
/// Deliberately not a metric row. A metric answers "what is the number"; a
/// finding answers "what did we see, where, when, and why does it matter",
/// which is the only kind of input a recommendation can honestly be built on.
model CompetitorFinding {
  id             String            @id @default(uuid())
  organizationId String
  projectId      String
  /// Null when the finding is about the customer's own site rather than a
  /// rival — "you have no city pages" is as much a finding as "they have six".
  competitorId   String?
  category       FindingCategory
  /// Short, human, and specific: "Two competitors have city landing pages".
  summary        String
  /// The observation itself, in plain language.
  detail         String
  /// Where it was read. A page URL, a Maps listing, a channel — anything the
  /// operator can open to see the same thing.
  sourceUrl      String?
  /// The platform the observation came from: WEBSITE | GOOGLE_MAPS | YOUTUBE |
  /// INSTAGRAM | SEARCH_CONSOLE.
  sourcePlatform String
  /// The measured value behind the finding, when there is one.
  metricName     String?
  metricValue    Float?
  /// The customer's equivalent, so a gap is visible without arithmetic.
  customerValue  Float?
  confidence     FindingConfidence @default(MEDIUM)
  /// When the underlying data was read, not when the row was written: a
  /// finding built from a week-old crawl must not look like today's.
  observedAt     DateTime
  createdAt      DateTime          @default(now())

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitor CompetitorDomain? @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  actions    StrategyAction[]

  @@index([projectId, category])
  @@index([projectId, observedAt])
}

/// One generation of the 30-day plan.
///
/// Kept as a run rather than overwriting a single plan so an operator can see
/// what changed between one week and the next, and so an action carried over
/// from a previous run is distinguishable from a new one.
model StrategyRun {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  /// PENDING | RUNNING | COMPLETED | FAILED
  status         String   @default("PENDING")
  /// The goal the plan was written against, copied in so a later change to the
  /// profile does not silently reinterpret an old plan.
  businessGoal   String?
  /// How many findings the plan was built from. A plan from three findings and
  /// a plan from forty deserve different trust, and the number says so.
  findingsUsed   Int      @default(0)
  /// Which surfaces had no data at all, so the plan can admit its blind spots
  /// instead of quietly omitting them.
  coverageGaps   String[]
  error          String?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions StrategyAction[]

  @@index([projectId, startedAt])
}

/// One thing to do, why, and what it was based on.
model StrategyAction {
  id             String         @id @default(uuid())
  organizationId String
  projectId      String
  runId          String
  category       FindingCategory
  title          String
  /// What to do, step by step. Stored as steps rather than prose so the UI can
  /// render a checklist and a person can stop halfway.
  steps          String[]
  /// Why this is worth doing, in plain language.
  rationale      String
  expectedImpact String
  /// Rough hours. Deliberately coarse — a false precision here would be read
  /// as a commitment.
  effortHours    Int
  priority       ActionPriority
  owner          ActionOwner
  /// 0-100. Computed, never authored: see OpportunityScoringService.
  opportunityScore Int
  /// The score in words, so nobody has to trust a number they cannot unpack.
  scoreExplanation String
  status         ActionStatus   @default(NOT_STARTED)
  dueDate        DateTime?
  /// Set the first time status became DONE, for completion reporting.
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  run      StrategyRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The evidence this action rests on. An action with none should not exist.
  findings CompetitorFinding[]

  @@index([projectId, status])
  @@index([runId, opportunityScore])
}
