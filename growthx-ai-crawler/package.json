{
  "name": "growthx-ai-crawler",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19"
  },
  "description": "Production-ready Enterprise Website Crawler for GrowthX AI SaaS platform",
  "author": "GrowthX AI Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:crawler": "node dist/main-worker",
    "start:crawler:dev": "nest start --entryFile main-worker --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "check:dead-code": "knip",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "script:reset-data": "node scripts/reset-data.js",
    "script:backfill-issue-identity": "npm run build && node scripts/backfill-issue-identity.js",
    "postinstall": "prisma generate",
    "build:render": "npm install && npx prisma generate && npm run build",
    "start:render": "npx prisma migrate deploy && npm run start:prod"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.13.0",
    "@googleapis/analyticsadmin": "^22.0.1",
    "@googleapis/analyticsdata": "^10.1.0",
    "@googleapis/businessprofileperformance": "^9.0.1",
    "@googleapis/mybusinessaccountmanagement": "^13.0.1",
    "@googleapis/mybusinessbusinessinformation": "^13.0.1",
    "@googleapis/searchconsole": "^11.0.1",
    "@googleapis/youtube": "^39.0.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^5.19.1",
    "axios": "^1.7.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.12.10",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "fast-xml-parser": "^5.11.2",
    "google-auth-library": "^11.0.2",
    "googleapis-common": "^9.1.0",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "openai": "^4.58.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "playwright": "^1.46.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simple-git": "^3.36.0",
    "socket.io": "^4.8.3",
    "ts-morph": "^28.0.0",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.16.2",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.9.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.19.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/modules/crawler/testing/jest-setup.ts"
    ],
    "testTimeout": 180000
  },
  "overrides": {
    "lodash": "^4.18.1",
    "picomatch@^4": "^4.0.7",
    "js-yaml": "^5.4.2"
  }
}
