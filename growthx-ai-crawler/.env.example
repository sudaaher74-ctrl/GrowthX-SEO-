# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Security & Authentication
# Dev-only escape hatch: skips DNS TXT domain-ownership verification.
# MUST stay false/unset in production — true lets anyone crawl any domain.
ALLOW_UNVERIFIED_DOMAINS=false

# Both are REQUIRED — the API refuses to boot without them. There are no
# fallback defaults, by design: a default committed here would be a public key.
# Generate each with: openssl rand -hex 32
# ENCRYPTION_KEY must be exactly 64 hex chars and decrypts stored customer
# integration credentials — rotating it orphans existing encrypted rows.
ENCRYPTION_KEY=
JWT_SECRET=

# Comma-separated browser origins allowed to call this API (CORS).
# Leave blank in development to allow http://localhost:3000 / :3001.
CORS_ALLOWED_ORIGINS=

# Set to "true" to expose Swagger at /api/docs when NODE_ENV=production.
ENABLE_SWAGGER_DOCS=false

# Comma-separated emails allowed into /api/admin (queue depth, LLM spend, and
# the directory of every organization on the platform). Roles in this product
# are per-organization, so there is no in-schema platform operator to check
# against — this list is it. Unset means nobody gets in, which is deliberate.
PLATFORM_ADMIN_EMAILS=

# Database (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/growthx_crawler?schema=public"

# Direct, unpooled connection, used only by Prisma Migrate — migrations take
# advisory locks and rely on session state, neither of which survives a
# connection pooler. On Neon this is DATABASE_URL with `-pooler` removed from
# the host; on a plain Postgres it is the same as DATABASE_URL. Leave it unset
# and docker-entrypoint.sh derives it, so only DATABASE_URL is required.
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Queue (Redis / BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Crawler Concurrency & Limits
DEFAULT_CRAWL_CONCURRENCY=5
MAX_CRAWL_CONCURRENCY=50
DEFAULT_CRAWL_DEPTH=5
MAX_CRAWL_DEPTH=20
RATE_LIMIT_DELAY_MS=500
PLAYWRIGHT_HEADLESS=true
USER_AGENT="GrowthX-AI-Bot/1.0 (+https://growthx.ai/bot)"

# AI Providers
# Gemini is the STARTER (₹2,000) model. GPT and Claude unlock on PRO (₹5,000)
# and are enforced by the billing entitlements, not by these keys.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-5
# Lets Anthropic re-serve a safety-declined request on its recommended fallback
# model inside the same call. Set to "false" if your account lacks the beta.
ANTHROPIC_SERVER_SIDE_FALLBACK=true

# Groq (Llama 3.1 8B Instant)
# Get a free API key at: https://console.groq.com
# Available on STARTER, GROWTH, PRO and ENTERPRISE plans.
# Defaults to llama-3.1-8b-instant if GROQ_MODEL is unset.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2000

# OpenRouter (routes to many vendors; free-tier models available)
# Get a free API key at: https://openrouter.ai/keys
# Available on STARTER, GROWTH, PRO and ENTERPRISE plans.
# Defaults to openai/gpt-oss-20b:free if OPENROUTER_MODEL is unset.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=2000
OPENROUTER_SITE_URL=https://growthx.ai
OPENROUTER_SITE_NAME=GrowthX AI SEO

# Sarvam AI (Indic Language Models, Translation & Speech)
# Get an API key at: https://sarvam.ai / https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
# /v1/chat/completions serves only these two ids. The earlier sarvam-2b and
# sarvam-m generation is retired; anything else here is corrected to
# sarvam-105b at startup with a warning rather than failing every call.
SARVAM_MODEL=sarvam-105b
#
# Sarvam-105B reasons before it answers, and reasoning tokens are charged
# against the same max_tokens budget as the answer. Left on with a budget sized
# for the answer alone, the model spends the whole allowance thinking and
# returns an empty or half-written response — billed, but with nothing to show.
# Blank disables reasoning so the entire budget goes to the answer, which is
# what every feature in this product wants. Set low|medium|high only for
# workloads that genuinely need the chain of thought, and raise
# SARVAM_MAX_OUTPUT_TOKENS to match when you do.
SARVAM_REASONING_EFFORT=
# Sarvam caps output tokens by plan: Starter 4096, Pro 16384, Business 128000.
# Requests above the account's ceiling are rejected outright, so this defaults
# to the Starter cap. Raise it to your plan's limit.
SARVAM_MAX_OUTPUT_TOKENS=4096

# Cost attribution. Anthropic rates are built in. Set these to report spend for
# the other vendors — left blank, token counts are reported and cost is null
# rather than guessed. USD per million tokens.
GEMINI_RATE_INPUT_PER_MTOK=
GEMINI_RATE_OUTPUT_PER_MTOK=
OPENAI_RATE_INPUT_PER_MTOK=
OPENAI_RATE_OUTPUT_PER_MTOK=
# Groq pricing: see https://groq.com/pricing (set to track spend; leave blank to skip)
GROQ_RATE_INPUT_PER_MTOK=
GROQ_RATE_OUTPUT_PER_MTOK=

# GrowthX Market Research
# Providers: sarvam | groq | openrouter | openai. All speak the Chat
# Completions API. Left unset, whichever key is present is used, preferring
# Sarvam (the platform's primary provider).
#
# Capability differences, which the product reports rather than hides:
#   sarvam     — no web search, no embeddings (client-owned evidence only)
#   groq       — no web search, no embeddings (client-owned evidence only)
#   openrouter — no web search, no embeddings
#   openai     — embeddings available, no web search via Chat Completions
MARKET_RESEARCH_PROVIDER=sarvam
# Model ids are overridable so a rename is a config change, not a deploy.
# Defaults per provider are in model-router.service.ts.
MARKET_RESEARCH_MODEL_ANALYST=
MARKET_RESEARCH_MODEL_WORKER=
MARKET_RESEARCH_MODEL_DEEP=
MARKET_RESEARCH_MODEL_EMBEDDING=

# Billing escape hatch. Refuses to work when NODE_ENV=production.
# Leave false: setting it true grants ENTERPRISE to every organization.
BILLING_DEV_BYPASS=false

# Session lifetime for the refresh token issued at login.
JWT_REFRESH_EXPIRES_IN=30d

# AI Visibility (AEO/GEO)
# Daily citation sweep at 06:00 UTC. Set to "false" to disable the cron.
AI_VISIBILITY_SWEEP_ENABLED=true

# Google PageSpeed Insights API
PAGESPEED_API_KEY=your_google_pagespeed_api_key

# Billing (Razorpay — INR subscriptions)
# STARTER = ₹2,000/mo (crawl + Gemini recommendations)
# PRO     = ₹5,000/mo (adds Claude, GPT, auto-fix PRs, AI visibility, strategy)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Optional: pin to plans already created in the Razorpay dashboard.
# Leave blank and the API creates them on first checkout.
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_GROWTH=
RAZORPAY_PLAN_ID_PRO=

# Storage (Local / S3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/snapshots
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=growthx-crawler-snapshots

# Observability (OpenTelemetry / Prometheus)
PROMETHEUS_PORT=9464
OTEL_SERVICE_NAME=growthx-ai-crawler

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000

# Local SEO
GOOGLE_PLACES_API_KEY=""

# ── Web search for Market Research ────────────────────────────────────────
#
# Without this, Market Research answers every question from the client's own
# crawl alone: the model providers cannot search the live web from a Chat
# Completions call, so "what changed in the market this week" comes back with
# nothing but the customer's own pages and a low-confidence verdict saying so.
#
# Tavily returns the page text with each result, which is what lets a page be
# cited — the pipeline only ever cites pages it actually read. Free tier is
# ~1,000 searches/month; get a key at https://tavily.com.
#
# Unset is a supported state, not a broken one: the run still answers, and the
# answer carries an evidence gap naming the missing search.
TAVILY_API_KEY=your_tavily_api_key_here
