# Settings for the laptop stack. Copy to `.env.selfhost` and fill in.
#
#   cp .env.selfhost.example .env.selfhost
#
# `.env.selfhost` holds live secrets and must never be committed. Check
# `.gitignore` covers it before your first commit on this machine.
#
# Only what the laptop needs is listed here. growthx-ai-crawler/.env.example
# documents every setting the API understands, with the reasoning for each.

# ── Database ────────────────────────────────────────────────────────────────
# Used by docker-compose.selfhost.yml to build DATABASE_URL. Any long random
# string; it never leaves the Docker network.
#   openssl rand -hex 16
POSTGRES_PASSWORD=

# ── Secrets the API refuses to boot without ─────────────────────────────────
#
# STOP before generating these if you are moving an existing Render deployment.
# ENCRYPTION_KEY decrypts stored customer integration credentials and
# INTEGRATION_TOKEN_KEY decrypts stored Google OAuth tokens. A new value does
# not fail — it silently cannot read what the old one wrote, and every
# connected Google account has to be reauthorized. Copy both from the Render
# dashboard (Environment tab) instead.
#
# For a fresh install, generate them:
#   ENCRYPTION_KEY:        openssl rand -hex 32     (exactly 64 hex chars)
#   JWT_SECRET:            openssl rand -hex 32
#   INTEGRATION_TOKEN_KEY: openssl rand -base64 32
ENCRYPTION_KEY=
JWT_SECRET=
INTEGRATION_TOKEN_KEY=

# ── Who may call this API from a browser ────────────────────────────────────
# Comma-separated, no trailing slash, exact scheme and host. Unset in
# production means no cross-origin request is allowed at all, which presents as
# a frontend that loads and then fails every request.
CORS_ALLOWED_ORIGINS=https://growth-x-seo.vercel.app

# Where the API sends a customer back to after a Google connector flow.
APP_BASE_URL=https://growth-x-seo.vercel.app
FRONTEND_URL=https://growth-x-seo.vercel.app

# ── Google OAuth ────────────────────────────────────────────────────────────
# Both URLs must also be registered as authorized redirect URIs on the OAuth
# client in Google Cloud Console, or Google rejects the consent request with
# redirect_uri_mismatch before the customer sees anything. Replace the host
# with your tunnel hostname.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/auth/google/callback
GOOGLE_REDIRECT_URI=https://api.example.com/api/integrations/google/callback

# ── AI providers ────────────────────────────────────────────────────────────
# Copy the ones you already have from the Render dashboard. Without any of
# them the API still crawls and audits; the AI tabs report "not configured"
# rather than degrading silently.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_MAX_OUTPUT_TOKENS=4096
MAMMOUTH_API_KEY=
MAMMOUTH_DEFAULT_MODEL=mammouth-recommended
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# USD per million tokens, from your plan. Left unset, every call records at
# unknown cost, the AI spend ledger reports zero, and a monthly budget can
# never fire.
SARVAM_RATE_INPUT_PER_MTOK=
SARVAM_RATE_OUTPUT_PER_MTOK=
MAMMOUTH_RATE_INPUT_PER_MTOK=
MAMMOUTH_RATE_OUTPUT_PER_MTOK=

# ── Optional data sources ───────────────────────────────────────────────────
TAVILY_API_KEY=
GOOGLE_PLACES_API_KEY=
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /api/admin. Unset denies everyone, which
# is the intended default.
PLATFORM_ADMIN_EMAILS=

# Dev-only escape hatch: skips DNS TXT domain-ownership verification. Leave
# false. True lets anyone crawl any domain from this machine, and the crawl
# traffic carries your home IP.
ALLOW_UNVERIFIED_DOMAINS=false
