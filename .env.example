# Copy to .env and fill in before `docker compose up`. Never commit .env.
#
# Compose refuses to start while any REQUIRED value below is empty, so a
# deployment cannot come up on a key that was published in this repository.

# --- REQUIRED ---------------------------------------------------------------
# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
# 64 hex characters. Encrypts stored Google credentials; changing it later
# makes existing connections unreadable, so keep it safe.
ENCRYPTION_KEY=
JWT_SECRET=

# --- Addresses ----------------------------------------------------------------
# Where a user's browser reaches the API. Baked into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Browser origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Where Google sign-in returns after the API completes login. Use your production frontend URL on the server.
FRONTEND_URL=http://localhost:3001

# --- AI providers (at least one, or AI features report themselves unavailable)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
# The low-cost policy pins approved models per task; no premium fallback.
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Competitor discovery: live market search (recommended) ------------------
TAVILY_API_KEY=

# --- Google: Business Profile, Search Console, Analytics sign-in ------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/integrations/google/callback
GOOGLE_PLACES_API_KEY=

# --- Tokens (all optional; empty means the built-in default) ----------------
# Each workspace has a token balance that AI use and geo-grid scans draw down.
# A monthly allowance refills on the 1st (UTC); bonus tokens never lapse. See
# docs/tokens.md before changing these.
#   TOKENS_ENFORCEMENT: enforce (default) | shadow (count, never block) | off
TOKENS_ENFORCEMENT=
#   Granted every month to a workspace with no allowance of its own (default 5000000).
TOKENS_MONTHLY_ALLOWANCE=
#   Tokens per piece of text the AI reads / writes (defaults 1 and 4).
TOKENS_AI_INPUT_WEIGHT=
TOKENS_AI_OUTPUT_WEIGHT=
#   Tokens a workspace must hold to start an AI call (default 1).
TOKENS_MIN_TO_START_AI=
#   One point of a geo-grid scan (default 5000).
TOKENS_COST_GEO_GRID_POINT=

# --- Only for growthx-ai-crawler/docker-compose.yml (monitoring stack) -------
GRAFANA_ADMIN_PASSWORD=

# Low-cost AI: target and conservative initial limits; see docs/operations/low-cost-ai-policy.md
AI_LOW_COST_POLICY=true
AI_PROVIDERS=gemini,openrouter
AI_PLATFORM_MONTHLY_INR=1000
AI_CUSTOMER_MONTHLY_INR=100
AI_VISIBILITY_MONTHLY_INR=70
AI_INTERNAL_MONTHLY_INR=20
AI_FIX_ENGINE_MONTHLY_INR=10
# Accounting buffer, not a live exchange-rate quote.
AI_ACCOUNTING_INR_PER_USD=100
AI_GOOGLE_PRICES_VERIFIED_AT=2026-10-15

